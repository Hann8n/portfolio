{
  // Gym Tracker Ads API — schedule sponsor ads for Gym Tracker
  "name": "gymtracker-ads-api",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/admin*", "/ads*"]
  },
  "d1_databases": [{
    "binding": "METRICS",
    "database_name": "gymtracker-metrics",
    "database_id": "38bea70b-a15c-4813-9585-2effdcba4361",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "METRICS_RATE_LIMITER", "namespace_id": "48130517",
    "simple": { "limit": 600, "period": 60 }
  }],
  "triggers": { "crons": ["23 7 * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_ISSUER": "https://orbyt-video.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "bd5a7772459973ac4a5d38222965f2d4af68423f9b97e16786d2731e241d4454"
  },
  "dev": {
    "host": "localhost"
  },
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "AD_CONFIG",
      "id": "bd8619902c0f4b2c87e4d99b71167dbc",
      "preview_id": "2cc6fba1dfe249c7876ee0b2e49600a2"
    }
  ],
  "routes": [
    {
      "pattern": "gymtracker.jackhannon.net/*",
      "zone_name": "jackhannon.net"
    },
    {
      "pattern": "gymtracker.jackhannon.net",
      "zone_name": "jackhannon.net"
    },
    {
      "pattern": "gymtracker.jackhannon.net/api/*",
      "zone_name": "jackhannon.net"
    },
    {
      "pattern": "gymtracker.jackhannon.net/admin*",
      "zone_name": "jackhannon.net"
    },
    {
      "pattern": "gymtracker.jackhannon.net/ads*",
      "zone_name": "jackhannon.net"
    }
  ]
}
